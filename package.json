{
  "name": "dsh-skills-manager",
  "version": "0.4.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check remote-installer.js && node --check github-source.js && node --test tests/*.test.js"
  },
  "description": "Manage Agent Skills (project + user roots) from the DSH sidebar: list, preview, create, edit, delete, enable/disable, validate, install.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills",
    "skill-management"
  ],
  "license": "MIT",
  "author": "Aero123421",
  "homepage": "https://github.com/Aero123421/dsh-skills-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-skills-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Aero123421/dsh-skills-manager/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "remote-installer.js",
    "github-source.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "dependencies": {
    "skills": "1.7.4",
    "yaml": "2.9.1"
  }
}
