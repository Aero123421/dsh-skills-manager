{
  "name": "dsh-skills-manager",
  "version": "0.1.0",
  "description": "Manage Agent Skills (project + user roots) from the DSH sidebar: list, preview, create, edit, delete, enable/disable, validate, install.",
  "keywords": ["dsh", "dsh-plugin", "skills", "skill-management"],
  "license": "MIT",
  "author": "Aero123421",
  "homepage": "https://github.com/Aero123421/dsh-skills-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-skills-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Aero123421/dsh-skills-manager/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection"]
    }
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" }
}
